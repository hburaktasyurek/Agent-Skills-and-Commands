#!/bin/sh
printf '%s\n' "$*" >> .gh-mock-calls

if [ "$1" = "auth" ]; then
  printf '%s\n' "Logged in to github.com as fixture-user"
  exit 0
fi

if [ "$1" = "repo" ]; then
  printf '%s\n' "release/2.x"
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "create" ]; then
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base) shift; printf '%s\n' "$1" > .gh-created-base ;;
      --title) shift; printf '%s\n' "$1" > .gh-created-title ;;
      --body-file) shift; cp "$1" .gh-created-body.md ;;
    esac
    shift
  done
  printf '%s\n' "https://github.example/acme/payments/pull/42"
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
  printf '%s\n' '{"url":"https://github.example/acme/payments/pull/42","baseRefName":"release/2.x","headRefName":"feature/retry-fence"}'
  exit 0
fi

exit 0
