#!/bin/sh
printf '%s\n' "$*" >> .gh-mock-calls

if [ "$1" = "auth" ]; then
  printf '%s\n' "Logged in to github.com as fixture-user"
  exit 0
fi

if [ "$1" = "repo" ]; then
  printf '%s\n' "release/2.x"
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "list" ] && [ -f .existing-pr ]; then
  printf '%s\n' '[{"number":42,"url":"https://github.example/acme/payments/pull/42","baseRefName":"release/2.x","headRefName":"feature/retry-fence","title":"Old retry draft"}]'
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "create" ]; then
  if [ -f .existing-pr ]; then
    printf '%s\n' "duplicate PR creation attempted" > .gh-duplicate-create
    exit 9
  fi
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base) shift; printf '%s\n' "$1" > .gh-created-base ;;
      --title) shift; printf '%s\n' "$1" > .gh-created-title ;;
      --body-file) shift; cp "$1" .gh-created-body.md ;;
    esac
    shift
  done
  printf '%s\n' "https://github.example/acme/payments/pull/42"
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "edit" ] && [ -f .existing-pr ]; then
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --title) shift; printf '%s\n' "$1" > .gh-edited-title ;;
      --body-file) shift; cp "$1" .gh-edited-body.md ;;
    esac
    shift
  done
  printf '%s\n' "https://github.example/acme/payments/pull/42"
  exit 0
fi

if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
  if [ -f .gh-edited-title ] && [ -f .gh-edited-body.md ]; then
    node -e 'const fs=require("fs"); console.log(JSON.stringify({url:"https://github.example/acme/payments/pull/42",baseRefName:"release/2.x",headRefName:"feature/retry-fence",title:fs.readFileSync(".gh-edited-title","utf8").trim(),body:fs.readFileSync(".gh-edited-body.md","utf8")}))'
  else
    printf '%s\n' '{"url":"https://github.example/acme/payments/pull/42","baseRefName":"release/2.x","headRefName":"feature/retry-fence","title":"Old retry draft","body":"This body describes an earlier head and says follow-up remains pending."}'
  fi
  exit 0
fi

exit 0
